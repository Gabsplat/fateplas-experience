# Copiar a .env.local. Las consultas siempre se guardan en data/contact/.
# En producción, indicar un directorio privado en un disco o volumen persistente.
CONTACT_DATA_DIR=

# none desactiva todo envío incluso si hay credenciales en el entorno.
# Activar únicamente cuando se quiera conectar: resend o smtp.
CONTACT_EMAIL_PROVIDER=none
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=

# Resend: requiere API key y remitente de un dominio verificado.
RESEND_API_KEY=

# Alternativa SMTP: se usa solo con CONTACT_EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
# true para TLS directo, normalmente puerto 465; false para STARTTLS, normalmente 587.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
